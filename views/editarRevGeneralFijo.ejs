<style>
  div.prueba12,
  div.PruebaDvi {
    display: none;
  }

  body {
    background:
      radial-gradient(circle at top left, rgba(59, 130, 246, 0.08), transparent 30%),
      radial-gradient(circle at bottom right, rgba(16, 185, 129, 0.08), transparent 30%),
      #f8fafc;
  }

  .crm-wrapper {
    max-width: 1450px;
    margin: 0 auto;
  }

  .crm-card {
    border: 0;
    border-radius: 28px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.10);
    backdrop-filter: blur(10px);
  }

  .crm-header {
    padding: 2rem 2.2rem;
    background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 55%, #2563eb 100%);
    color: #fff;
  }

  .crm-header h2 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
    letter-spacing: -0.03em;
  }

  .crm-header p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.98rem;
  }

  .period-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
  }

  .period-chip strong {
    font-weight: 800;
  }

  .crm-body {
    padding: 2rem;
  }

  .section-card {
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    border: 1px solid #eaf0f6;
    border-radius: 22px;
    padding: 1.4rem 1.4rem 0.4rem;
    margin-bottom: 1.4rem;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .section-title-dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: linear-gradient(135deg, #2563eb, #60a5fa);
    box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.08);
  }

  .section-title h5 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    color: #64748b;
    font-size: 0.9rem;
    margin-bottom: 1.15rem;
  }

  .form-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #334155;
    margin-bottom: 0.45rem;
  }

  .form-control,
  .form-select {
    min-height: 52px;
    border-radius: 16px;
    border: 1px solid #d9e3ef;
    background: #fff;
    color: #0f172a;
    padding-left: 0.95rem;
    padding-right: 0.95rem;
    transition: all 0.18s ease;
    box-shadow: none !important;
    width: 100%;
  }

  .form-control:disabled {
    background: #f1f5f9;
    color: #64748b;
    border-color: #e2e8f0;
    cursor: not-allowed;
  }

  .form-control:hover:not(:disabled),
  .form-select:hover {
    border-color: #bfd1e5;
  }

  .form-control:focus:not(:disabled),
  .form-select:focus {
    border-color: #60a5fa;
    transform: translateY(-1px);
    box-shadow: 0 0 0 0.22rem rgba(37, 99, 235, 0.12) !important;
  }

  .payment-row {
    padding: 1rem 0 0.25rem;
    border-top: 1px solid #eef2f7;
    margin-top: 0.5rem;
  }

  .payment-row:first-of-type {
    border-top: 0;
    margin-top: 0;
    padding-top: 0;
  }

  .payment-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: linear-gradient(135deg, #2563eb, #60a5fa);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .sticky-actions {
    position: sticky;
    bottom: 0;
    z-index: 20;
    margin-top: 1.5rem;
    padding-top: 1rem;
    background: linear-gradient(to top, rgba(255,255,255,0.96), rgba(255,255,255,0.7), transparent);
    backdrop-filter: blur(8px);
  }

  .btn-save {
    border: 0;
    border-radius: 16px;
    padding: 0.95rem 2.2rem;
    font-size: 0.98rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    box-shadow: 0 16px 30px rgba(37, 99, 235, 0.22);
    color: #fff;
  }

  .btn-save:hover {
    transform: translateY(-1px);
    box-shadow: 0 20px 36px rgba(37, 99, 235, 0.28);
    color: #fff;
  }

  .btn-cancel {
    border-radius: 16px;
    padding: 0.95rem 2rem;
    font-size: 0.98rem;
    font-weight: 700;
    border: 1px solid #d9e3ef;
    background: #fff;
    color: #475569;
  }

  .btn-cancel:hover {
    background: #f8fafc;
    border-color: #bfd1e5;
    color: #334155;
  }

  @media (max-width: 768px) {
    .crm-header {
      padding: 1.4rem;
    }

    .crm-header h2 {
      font-size: 1.55rem;
    }

    .crm-body {
      padding: 1rem;
    }

    .section-card {
      padding: 1rem 1rem 0.25rem;
      border-radius: 18px;
    }
  }
</style>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>

<div class="container py-4 py-lg-5 crm-wrapper">
  <div class="crm-card">
    <div class="crm-header">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
          <h2>Editar Revenue Fijo</h2>
          <p>Actualice la activación, facturación y pagos del servicio fijo.</p>
        </div>

        <div class="period-chip">
          <span>Período</span>
          <strong><%= mes %> <%= anio %></strong>
        </div>
      </div>
    </div>

    <div class="crm-body">
      <form action="/editRevFijo/<%= mes %>/<%= anio %>" method="POST">
        <input type="hidden" id="SaleId" name="SaleId" value="<%= SaleId.SaleId %>">

        <div class="section-card">
          <div class="section-title">
            <span class="section-title-dot"></span>
            <h5>Información de la venta</h5>
          </div>
          <div class="section-subtitle">Datos de referencia y fecha de activación.</div>

          <div class="row">
            <div class="col-md-4 mb-4">
              <label class="form-label" for="saleIdDisplay">Número de Venta</label>
              <input type="text" id="saleIdDisplay" class="form-control form-control-lg" value="<%= SaleId.SaleId %>" disabled>
            </div>

            <div class="col-md-4 mb-4">
              <label class="form-label" for="celularTramite">Celular de Trámite</label>
              <input type="text" id="celularTramite" class="form-control form-control-lg" value="<%= SaleId.Celular_Tramite %>" disabled>
            </div>

            <div class="col-md-4 mb-4">
              <label class="form-label" for="numeroAbonado">Número de Abonado</label>
              <input type="text" id="numeroAbonado" class="form-control form-control-lg" value="<%= SaleId.Numero_Abonado %>" disabled>
            </div>

            <div class="col-md-4 mb-4">
              <label class="form-label" for="fechaActivacion">Fecha de Activación</label>
              <input type="date" id="fechaActivacion" class="form-control form-control-lg" name="column33" value="<%= SaleId.formatted_Fecha_Activacion %>">
            </div>

            <div class="col-md-4 mb-4">
              <label class="form-label" for="nombreCliente">Nombre Cliente</label>
              <input type="text" id="nombreCliente" class="form-control form-control-lg" value="<%= SaleId.Nombre_Cliente %>" disabled>
            </div>

            <div class="col-md-4 mb-4">
              <label class="form-label" for="primerApellido">Primer Apellido Cliente</label>
              <input type="text" id="primerApellido" class="form-control form-control-lg" value="<%= SaleId.Primer_Apellido_Cliente %>" disabled>
            </div>
          </div>
        </div>

        <div class="section-card">
          <div class="section-title">
            <span class="section-title-dot"></span>
            <h5>Pagos del cliente</h5>
          </div>
          <div class="section-subtitle">Estado de factura, monto y fecha de pago por período.</div>

          <% for (let i = 1; i <= 6; i++) { %>
            <div class="payment-row">
              <span class="payment-badge"><%= i %></span>

              <div class="row">
                <div class="col-md-4 mb-4">
                  <label class="form-label" for="columnF<%= i %>">Factura <%= i %></label>
                  <select class="form-select form-select-lg" id="columnF<%= i %>" name="columnF<%= i %>">
                    <option value="<%= SaleId["Factura_" + i] %>"><%= SaleId["Factura_" + i] %></option>
                    <option value="PAGO">PAGO</option>
                    <option value="SAA">SAA</option>
                    <option value="BAA">BAA</option>
                    <option value="SIN FACTURAR">SIN FACTURAR</option>
                    <option value="NO PAGO">NO PAGO</option>
                  </select>
                </div>

                <div class="col-md-4 mb-4">
                  <label class="form-label" for="columnM<%= i %>">Monto <%= i %></label>
                  <input type="number" step="0.01" id="columnM<%= i %>" name="columnM<%= i %>"
                         class="form-control form-control-lg" placeholder="0.00"
                         value="<%= SaleId["Monto_" + i] %>">
                </div>

                <div class="col-md-4 mb-4">
                  <label class="form-label" for="columnFP<%= i %>">Fecha de Pago <%= i %></label>
                  <input type="date" id="columnFP<%= i %>" name="columnFP<%= i %>"
                         class="form-control form-control-lg"
                         value="<%= SaleId["formatted_Fecha_Pago_" + i] %>">
                </div>
              </div>
            </div>
          <% } %>
        </div>

        <div class="sticky-actions d-flex justify-content-end gap-2">
          <a href="/RevenueFijo/<%= mes %>/<%= anio %>" class="btn btn-lg btn-cancel">Volver</a>
          <button class="btn btn-primary btn-lg btn-save" type="submit">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>
